# QFF26 configuration.
#
# Every value is optional: unset keys fall back to a visible TBD placeholder or
# a "#" link, so the site builds and renders without any of them. Only values
# genuinely needed in the browser use the NEXT_PUBLIC_ prefix.

NEXT_PUBLIC_SITE_URL=https://qff26.quantumx.foundation

# Event datetime, ISO 8601 with offset. Defaults in data/event.ts to
# 2026-10-10T00:00:00+05:30 (start of the confirmed date, IST). Set this once
# the exact start time of day is confirmed; the countdown follows it.
NEXT_PUBLIC_EVENT_STARTS_AT=
NEXT_PUBLIC_EVENT_ENDS_AT=
NEXT_PUBLIC_EVENT_TIMEZONE=

# Conversion and external destinations.
NEXT_PUBLIC_REGISTRATION_URL=
NEXT_PUBLIC_SPEAKER_URL=
NEXT_PUBLIC_SPONSOR_URL=
NEXT_PUBLIC_PRESS_URL=
NEXT_PUBLIC_CREATOR_URL=
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_CODE_OF_CONDUCT_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_COMMUNITY_EVENTS_URL=
NEXT_PUBLIC_ARCHIVE_URL=
NEXT_PUBLIC_RECAP_URL=

# Social profiles.
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_DISCORD=
